---
import Base from "../../layouts/Base.astro";
import TrendChart from "../../components/TrendChart.astro";
import { LANGS, type Lang, t, url } from "../../lib/i18n";
import {
	headlineSeries,
	history,
	meta,
	regionName,
	storefrontOf,
	tierName,
} from "../../lib/data";

export function getStaticPaths() {
	return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const zh = lang === "zh";

const series = headlineSeries();
const days = history.days;
const changes = history.changes;
const single = days.length < 2;

const title = `${t(lang, "historyTitle")} — ${t(lang, "siteName")}`;
const description = t(lang, "historySub");
---

<Base {lang} {title} {description} path="history" nav="history">
	<section class="wrap head">
		<p class="eyebrow">
			{t(lang, "daysCollected", { n: days.length })} · {days[0]} → {days[days.length - 1]}
		</p>
		<div class="row">
			<div>
				<h1>{t(lang, "historyTitle")}</h1>
				<p class="sub">{t(lang, "historySub")}</p>
			</div>
			<div class="stats">
				<div>
					<p class="eyebrow">{zh ? "快照天数" : "Snapshots"}</p>
					<p class="v num">{days.length}</p>
				</div>
				<div>
					<p class="eyebrow">{zh ? "变价记录" : "Changes"}</p>
					<p class="v num">{changes.length}</p>
				</div>
			</div>
		</div>
	</section>

	{
		single && (
			<div class="wrap">
				<aside class="empty">
					<p class="eyebrow t">{t(lang, "historyEmpty")}</p>
					<p class="b">{t(lang, "historyEmptyBody", { date: days[0] ?? meta.dataDate })}</p>
				</aside>
			</div>
		)
	}

	<section class="wrap chartwrap">
		<TrendChart {lang} {series} {days} />
	</section>

	<section class="wrap grid">
		<div>
			<h2 class="eyebrow">{t(lang, "changesTitle")}</h2>
			{
				changes.length === 0 ? (
					<p class="none">{t(lang, "changesEmpty")}</p>
				) : (
					<div class="scroll-x">
						<table class="ct">
							<thead>
								<tr>
									<th scope="col">{zh ? "日期" : "Date"}</th>
									<th scope="col" />
									<th scope="col">{t(lang, "colTier")}</th>
									<th scope="col">{zh ? "本地价" : "Local price"}</th>
									<th scope="col" class="r">{zh ? "变动" : "Change"}</th>
								</tr>
							</thead>
							<tbody>
								{changes.slice(0, 40).map((c) => {
									const sf = storefrontOf(c.storefront);
									const up = c.pct > 0;
									return (
										<tr>
											<td class="num d">{c.date}</td>
											<td>
												<a href={url(lang, `r/${c.storefront}`)} class="code">
													{c.storefront.toUpperCase()}
												</a>
											</td>
											<td class="tn">
												<a href={url(lang, `p/${c.productId}/${c.tier}`)}>
													{tierName(c, lang)}
												</a>
												<span class="per">
													{t(lang, c.period === "annual" ? "annual" : "monthly")}
												</span>
												{sf && <span class="rn">{regionName(sf, lang)}</span>}
											</td>
											<td class="num lp">
												{c.fromRaw} <span class="arrow">→</span> {c.toRaw}
											</td>
											<td class="num r" data-dir={up ? "up" : "down"}>
												{up ? "+" : "−"}
												{Math.abs(c.pct * 100).toFixed(1)}%
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				)
			}
			<p class="note">{t(lang, "changesNote")}</p>
		</div>

		<aside class="why">
			<h2 class="eyebrow">{t(lang, "whyHistory")}</h2>
			<p>
				{
					zh
						? "地区价格是活数据。土耳其曾长期被推荐为 ChatGPT 最便宜的地区，如今已排到第 97 位；网上多数攻略仍停留在调价之前。"
						: "Regional prices move. Turkey was long recommended as the cheapest storefront for ChatGPT; it now sits at #97, while most guides still say otherwise."
				}
			</p>
			<p>
				{
					zh
						? "单日快照会过期，连续快照才能看出趋势。本站每日固定时间抓取一次，只追加不覆盖，并保留 Apple 返回的原始价格字符串。"
						: "A single snapshot goes stale; consecutive ones show a trend. This site captures once a day, appends rather than overwrites, and keeps the raw string Apple returned."
				}
			</p>
			<p>
				{
					zh
						? "变价只比较本地货币标价。汇率天天在动，如果按美元比，每一次汇率波动都会被误报成厂商调价。"
						: "Changes compare the local-currency price only. Exchange rates move daily; comparing in USD would report every currency wobble as a price change."
				}
			</p>
		</aside>
	</section>
</Base>

<style>
	.head {
		padding-block: 34px 22px;
	}
	.row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
		flex-wrap: wrap;
		margin-top: 16px;
	}
	h1 {
		font-size: 40px;
		line-height: 1.1;
		margin: 0 0 12px;
	}
	.sub {
		margin: 0;
		font-size: 14px;
		line-height: 1.65;
		color: var(--ink2);
		max-width: 52em;
	}
	.stats {
		display: flex;
		border: 1px solid var(--rule);
		background: var(--surface);
		flex: none;
	}
	.stats > div {
		padding: 11px 20px;
		border-right: 1px solid var(--rule);
	}
	.stats > div:last-child {
		border-right: 0;
	}
	.stats p {
		margin: 0;
	}
	.stats .v {
		font-size: 19px;
		margin-top: 5px;
	}

	.empty {
		margin-bottom: 20px;
		padding: 13px 18px;
		border-left: 2px solid var(--ink);
		background: var(--surface);
	}
	.empty .t {
		margin: 0 0 6px;
		color: var(--ink);
	}
	.empty .b {
		margin: 0;
		font-size: 12.5px;
		line-height: 1.7;
		color: var(--ink2);
		max-width: 60em;
	}

	.chartwrap {
		padding-bottom: 34px;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: 56px;
		padding-bottom: 44px;
	}
	.none {
		margin: 16px 0 0;
		font-size: 13px;
		color: var(--ink3);
		padding: 14px 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.ct {
		width: 100%;
		border-collapse: collapse;
		min-width: 640px;
		margin-top: 12px;
	}
	.ct thead th {
		font-size: 10.5px;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink3);
		font-weight: 600;
		text-align: left;
		padding: 0 10px 9px;
		border-bottom: 1px solid var(--ink);
	}
	.ct th.r,
	.ct td.r {
		text-align: right;
	}
	.ct tbody td {
		padding: 13px 10px;
		border-bottom: 1px solid var(--rule);
		vertical-align: baseline;
	}
	.d {
		font-size: 12px;
		color: var(--ink3);
		width: 96px;
	}
	.tn {
		font-size: 13.5px;
	}
	.per,
	.rn {
		font-size: 11.5px;
		color: var(--ink3);
		margin-left: 8px;
	}
	.lp {
		font-size: 12.5px;
		color: var(--ink2);
		width: 200px;
	}
	.arrow {
		color: var(--ink3);
		padding: 0 2px;
	}
	td.r {
		font-size: 13.5px;
		font-weight: 500;
		width: 100px;
	}
	td.r[data-dir="up"] {
		color: var(--up);
	}
	td.r[data-dir="down"] {
		color: var(--down);
	}
	.note {
		margin: 15px 0 0;
		font-size: 11.5px;
		color: var(--ink3);
		line-height: 1.7;
	}
	.why {
		border-left: 1px solid var(--rule);
		padding-left: 32px;
	}
	.why p {
		margin: 0 0 14px;
		font-size: 13px;
		line-height: 1.72;
		color: var(--ink2);
	}
	.why h2 {
		margin-bottom: 16px;
	}

	@media (max-width: 980px) {
		h1 {
			font-size: 28px;
		}
		.grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.why {
			border-left: 0;
			border-top: 1px solid var(--rule);
			padding-left: 0;
			padding-top: 20px;
		}
	}
</style>
