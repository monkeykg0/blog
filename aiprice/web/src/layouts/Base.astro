---
import "../styles/global.css";
import { HTML_LANG, LANGS, type Lang, t, url } from "../lib/i18n";
import { meta } from "../lib/data";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";

interface Props {
	lang: Lang;
	title: string;
	description: string;
	/** 当前页在其它语言下的路径（不含语言前缀），用于 hreflang 与语言切换 */
	path?: string;
	nav?: "products" | "regions" | "history" | "method";
}

const { lang, title, description, path = "", nav } = Astro.props;
const canonical = new URL(url(lang, path), Astro.site).href;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		{/* 双语站不配 hreflang 会被判重复内容 */}
		{
			LANGS.map((l) => (
				<link
					rel="alternate"
					hreflang={HTML_LANG[l]}
					href={new URL(url(l, path), Astro.site).href}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={new URL(url("en", path), Astro.site).href} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="robots" content="index,follow" />

		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#14140f" media="(prefers-color-scheme: dark)" />
	</head>
	<body>
		<Masthead lang={lang} path={path} nav={nav} />
		<main>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
